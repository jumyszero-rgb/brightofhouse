generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model AdminCode {
  id        String   @id @default(uuid())
  code      String
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model BeforeAfter {
  id          String   @id @default(uuid())
  title       String
  description String?
  beforeUrl   String
  afterUrl    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model CompanyProfile {
  id              String   @id @default("main")
  name            String   @default("合同会社むすびえむ")
  representative  String?
  address         String?
  tel             String?
  businessContent String?
  businessHours   String?
  mapCode         String?
  updatedAt       DateTime @updatedAt
}

model HeroSettings {
  id           String   @id @default("main")
  title        String   @default("北海道ブライトオブハウス")
  subtitle     String   @default("水回りクリーニング / ハウスクリーニング / ゴミ屋敷清掃")
  btn1Text     String   @default("無料お見積り")
  btn1Link     String   @default("/contact")
  btn2Text     String   @default("料金を見る")
  btn2Link     String   @default("/service")
  updatedAt    DateTime @updatedAt
  mobileHeight String   @default("h-[50vh]")
  pcHeight     String   @default("md:h-[65vh]")
}

model PromotionVideo {
  id         String   @id @default(uuid())
  title      String
  videoUrl   String
  deviceType String
  createdAt  DateTime @default(now())
}

model GalleryImage {
  id        String   @id @default(uuid())
  imageUrl  String
  title     String?
  createdAt DateTime @default(now())
}

model ServiceMenu {
  id          String   @id @default(uuid())
  title       String
  price       String
  unit        String   @default("円〜")
  description String?
  features    String?
  isPopular   Boolean  @default(false)
  order       Int      @default(0)
  link        String   @default("/service")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  priceNote   String?
}

model ServiceCategory {
  id        String        @id @default(uuid())
  title     String
  order     Int           @default(0)
  createdAt DateTime      @default(now())
  items     ServiceItem[]
}

model ServiceItem {
  id               String          @id @default(uuid())
  title            String
  subTitle         String?
  order            Int             @default(0)
  categoryId       String
  discountPrice    String?
  regularPrice     String?
  basePrice        Int             @default(0)
  estimatedMinutes Int             @default(60)
  notes            String?
  details          ServiceDetail[]
  category         ServiceCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  options          ServiceOption[]
}

model ServiceDetail {
  id         String      @id @default(uuid())
  label      String?
  value      String
  order      Int         @default(0)
  itemId     String
  labelAlign String      @default("left")
  labelColor String      @default("default")
  labelSize  String      @default("sm")
  valueAlign String      @default("right")
  valueColor String      @default("default")
  valueSize  String      @default("base")
  item       ServiceItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
}

model ServiceOption {
  id                String      @id @default(uuid())
  title             String
  price             Int         @default(0)
  additionalMinutes Int         @default(0)
  itemId            String
  regularPrice      String?
  subTitle          String?
  discountType      String      @default("NONE")
  discountValue     Int         @default(0)
  linkedItemId      String?
  item              ServiceItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
}

model ServiceArea {
  id        String   @id @default(uuid())
  title     String
  regions   String
  note      String?
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model LandingPage {
  id              String   @id @default(uuid())
  slug            String   @unique
  title           String
  status          String   @default("DRAFT")
  heroImage       String?
  catchphrase     String?
  subCopy         String?
  content         String?
  ctaText         String?  @default("無料お見積りはこちら")
  ctaLink         String?  @default("/contact")
  blocks          Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  showOnHome      Boolean  @default(false)
  category        String   @default("CAMPAIGN")
  linkTitle       String?
  metaDescription String?
  metaKeywords    String?
  noIndex         Boolean  @default(false)
  showBottomCta   Boolean  @default(true)

}

model BlogPost {
  id              String   @id @default(uuid())
  slug            String   @unique
  title           String
  content         String
  instaContent    String?
  xContent        String?
  googleContent   String?
  thumbnail       String?
  status          String   @default("DRAFT")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  metaDescription String?
  metaKeywords    String?
  noIndex         Boolean  @default(false)

}

model BlogSettings {
  id            String   @id @default("main")
  fixedKeywords String   @default("")
  defaultIntro  String   @default("")
  defaultOutro  String   @default("")
  updatedAt     DateTime @updatedAt
}

model IndexNowLog {
  id        String   @id @default(uuid())
  url       String   @unique
  status    Int
  response  String?
  createdAt DateTime @default(now())
}

model SiteSettings {
  id            String   @id @default("main")
  robotsTxt     String   @default("User-agent: *\nAllow: /\nDisallow: /admin/")
  reviewIpBlock Boolean  @default(true)
  updatedAt     DateTime @updatedAt
}


model Booking {
  id           String   @id @default(uuid())
  category     String
  customerName String
  email        String
  phone        String
  startTime    DateTime
  endTime      DateTime
  status       String   @default("PENDING")
  createdAt    DateTime @default(now())
  items        String
  totalMinutes Int
  totalPrice   Int
  address      String?
  notes        String?
}

model CalendarOverride {
  id        String   @id @default(uuid())
  slotTime  DateTime @unique
  status    String
  note      String?
  updatedAt DateTime @updatedAt
}

model ServicePage {
  id              String   @id @default(uuid())
  slug            String   @unique
  title           String
  linkTitle       String?
  heroImage       String?
  catchphrase     String?
  content         String?
  status          String   @default("DRAFT")
  metaKeywords    String?
  metaDescription String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  serviceItemId   String?
  bookingData     Json?
  noIndex         Boolean  @default(false)

}

model BookingCategory {
  id        String        @id @default(uuid())
  title     String
  order     Int           @default(0)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  menus     BookingMenu[]
}

model BookingMenu {
  id          String           @id @default(uuid())
  title       String
  basePrice   Int              @default(0)
  durationMin Int              @default(0)
  order       Int              @default(0)
  categoryId  String
  basicItems  String?
  notes       String?
  priceNote   String?
  category    BookingCategory  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  subMenus    BookingSubMenu[]
}

model BookingSubMenu {
  id          String          @id @default(uuid())
  title       String
  price       Int             @default(0)
  durationMin Int             @default(0)
  order       Int             @default(0)
  menuId      String
  options     BookingOption[]
  menu        BookingMenu     @relation(fields: [menuId], references: [id], onDelete: Cascade)
}

model BookingOption {
  id          String         @id @default(uuid())
  title       String
  price       Int            @default(0)
  durationMin Int            @default(0)
  order       Int            @default(0)
  subMenuId   String
  subMenu     BookingSubMenu @relation(fields: [subMenuId], references: [id], onDelete: Cascade)
}

model TopPriceItem {
  id        String   @id @default(uuid())
  title     String
  price     String
  unit      String   @default("円〜(税込)")
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ReviewLog {
  id        String   @id @default(cuid())
  ip        String
  rating    Int
  createdAt DateTime @default(now())

  @@index([ip, createdAt])
}

