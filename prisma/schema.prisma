// @/prisma/schema.prisma

generator client {
  provider      = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// 1. 管理画面2段階認証用コード
model AdminCode {
  id        String   @id @default(uuid())
  code      String   // 6桁の数字
  expiresAt DateTime // 有効期限
  createdAt DateTime @default(now())
}

// 2. 清掃実績 (Before/After)
model BeforeAfter {
  id          String   @id @default(uuid())
  title       String   // 作業タイトル
  description String?  // 説明文
  beforeUrl   String   // Before画像URL
  afterUrl    String   // After画像URL
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// 3. 会社概要
model CompanyProfile {
  id              String   @id @default("main")
  name            String   @default("合同会社むすびえむ")
  representative  String?  // 代表者名
  address         String?  // 所在地
  tel             String?  // 電話番号
  businessContent String?  // 事業内容
  businessHours   String?  // 営業時間
  mapCode         String?  // Googleマップ埋め込みコード
  updatedAt       DateTime @updatedAt
}

// 4. ヒーローエリア設定 (トップページ上部)
model HeroSettings {
  id           String   @id @default("main")
  title        String   @default("北海道ブライトオブハウス")
  subtitle     String   @default("水回りクリーニング / ハウスクリーニング / ゴミ屋敷清掃")
  mobileHeight String   @default("h-[50vh]")
  pcHeight     String   @default("md:h-[65vh]")
  btn1Text     String   @default("無料お見積り")
  btn1Link     String   @default("/contact")
  btn2Text     String   @default("料金を見る")
  btn2Link     String   @default("/service")
  updatedAt    DateTime @updatedAt
}

// 5. プロモーション動画
model PromotionVideo {
  id         String   @id @default(uuid())
  title      String
  videoUrl   String   // R2のURL
  deviceType String   // "pc" または "mobile"
  createdAt  DateTime @default(now())
}

// 6. 実績ギャラリー (スライダー用単体画像)
model GalleryImage {
  id        String   @id @default(uuid())
  imageUrl  String   // R2のURL
  title     String?
  createdAt DateTime @default(now())
}

// 7. 人気メニュー (トップページ用)
model ServiceMenu {
  id          String   @id @default(uuid())
  title       String
  price       String
  priceNote   String?  // 価格の補足 (例: 2点, 壁掛け)
  unit        String   @default("円〜")
  description String?
  features    String?  // 改行区切り
  isPopular   Boolean  @default(false)
  order       Int      @default(0)
  link        String   @default("/service")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// 8. サービス・料金表 大分類 (水回り, ハウスクリーニング等)
model ServiceCategory {
  id        String   @id @default(uuid())
  title     String
  order     Int      @default(0)
  items     ServiceItem[]
  createdAt DateTime @default(now())
}

// 9. サービス・料金表 中分類 (キッチン, トイレ等)
model ServiceItem {
  id            String   @id @default(uuid())
  title         String
  subTitle      String?  
  
  // ▼ 予約・計算用の追加項目
  basePrice        Int     @default(0)  // 計算用基本単価 (例: 14000)
  estimatedMinutes Int     @default(60) // 作業時間目安 (分)
  
  regularPrice  String?  // 表示用テキスト (従来通り)
  discountPrice String?  // 表示用テキスト (従来通り)
  order         Int      @default(0)
  categoryId    String
  category      ServiceCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  details       ServiceDetail[]
  options       ServiceOption[] // ▼ オプション紐付け
}

// 10. サービス・料金表 詳細 (作業内容の箇条書き等)
model ServiceDetail {
  id          String   @id @default(uuid())
  label       String?
  value       String
  labelColor  String   @default("default")
  labelSize   String   @default("sm")
  labelAlign  String   @default("left")
  valueColor  String   @default("default")
  valueSize   String   @default("base")
  valueAlign  String   @default("right")
  order       Int      @default(0)
  itemId      String
  item        ServiceItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
}

// 11. 新設: サービスオプション (撥水コート, 消臭等)
model ServiceOption {
  id                String      @id @default(uuid())
  title             String
  price             Int         @default(0) // オプション価格
  additionalMinutes Int         @default(0) // 追加作業時間
  itemId            String
  item              ServiceItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
}

// 12. 対応エリア (旧方式)
model ServiceArea {
  id        String   @id @default(uuid())
  title     String
  regions   String   // 改行区切り地域
  note      String?
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// 13. ランディングページ (LP)
model LandingPage {
  id          String   @id @default(uuid())
  slug        String   @unique
  title       String   // ページ内H1タイトル (SEO用)
  linkTitle   String?  // トップや一覧で使う短いタイトル (任意)

  category    String   @default("CAMPAIGN") // CAMPAIGN (キャンペーン) or AREA (地域別)
  status      String   @default("DRAFT")    // DRAFT or PUBLISHED
  showOnHome  Boolean  @default(false)      // トップページに表示するか

  heroImage   String?
  catchphrase String?
  subCopy     String?
  content     String?
  ctaText     String?  @default("無料お見積りはこちら")
  ctaLink     String?  @default("/contact")
  blocks      Json?    // 将来のブロック型拡張用
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// 14. ブログ記事管理
model BlogPost {
  id            String   @id @default(uuid())
  slug          String   @unique
  title         String
  content       String   // リッチテキスト（HTML）
  
  // SNS投稿用フィールド
  instaContent  String?  // Instagram用
  xContent      String?  // X (Twitter)用
  googleContent String?  // Googleビジネスプロフィール用

  thumbnail     String?  // アイキャッチ画像
  status        String   @default("DRAFT") // DRAFT or PUBLISHED
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// 15. ブログ全体のAI執筆用設定
model BlogSettings {
  id            String   @id @default("main")
  fixedKeywords String   @default("") // 毎回含める固定キーワード
  defaultIntro  String   @default("") // 毎回最初に記載する定型文
  defaultOutro  String   @default("") // 毎回最後に記載する定型文
  updatedAt     DateTime @updatedAt
}

// 16. IndexNow通知ログ
model IndexNowLog {
  id        String   @id @default(uuid())
  url       String   @unique // 通知したURL
  status    Int      // HTTPステータスコード
  response  String?  // APIからの応答
  createdAt DateTime @default(now())
}

// 17. サイト全体設定 (robots.txtなど)
model SiteSettings {
  id        String   @id @default("main")
  robotsTxt String   @default("User-agent: *\nAllow: /\nDisallow: /admin/")
  updatedAt DateTime @updatedAt
}

// 18. 予約データ
model Booking {
  id           String   @id @default(uuid())
  category     String
  items        String   // 選択した項目のリスト (カンマ区切り等)
  customerName String
  email        String
  phone        String
  startTime    DateTime
  endTime      DateTime
  totalPrice   Int      // 最終計算価格
  totalMinutes Int      // 合計作業時間 (これでカレンダー枠をロック)
  status       String   @default("PENDING")
  createdAt    DateTime @default(now())
}