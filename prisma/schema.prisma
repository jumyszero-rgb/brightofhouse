generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model AdminCode {
  id        String   @id @default(uuid())
  code      String
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model BeforeAfter {
  id           String        @id @default(uuid())
  title        String
  description  String?
  beforeUrl    String
  afterUrl     String
  category     String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  servicePages ServicePage[]
  landingPages LandingPage[]
}

model CompanyProfile {
  id              String   @id @default("main")
  name            String   @default("合同会社むすびえむ")
  representative  String?
  address         String?
  tel             String?
  businessContent String?
  businessHours   String?
  mapCode         String?
  updatedAt       DateTime @updatedAt
}

model HeroSettings {
  id           String   @id @default("main")
  title        String   @default("北海道ブライトオブハウス")
  subtitle     String   @default("水回りクリーニング / ハウスクリーニング / ゴミ屋敷清掃")
  btn1Text     String   @default("無料お見積り")
  btn1Link     String   @default("/contact")
  btn2Text     String   @default("料金を見る")
  btn2Link     String   @default("/service")
  updatedAt    DateTime @updatedAt
  mobileHeight String   @default("h-[50vh]")
  pcHeight     String   @default("md:h-[65vh]")
}

model PromotionVideo {
  id         String   @id @default(uuid())
  title      String
  videoUrl   String
  deviceType String
  createdAt  DateTime @default(now())
}

model GalleryImage {
  id        String   @id @default(uuid())
  imageUrl  String
  title     String?
  createdAt DateTime @default(now())
}

model ServiceMenu {
  id          String   @id @default(uuid())
  title       String
  price       String
  unit        String   @default("円〜")
  description String?
  features    String?
  isPopular   Boolean  @default(false)
  order       Int      @default(0)
  link        String   @default("/service")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  priceNote   String?
}

model ServiceCategory {
  id        String        @id @default(uuid())
  title     String
  order     Int           @default(0)
  createdAt DateTime      @default(now())
  items     ServiceItem[]
}

model ServiceItem {
  id               String          @id @default(uuid())
  title            String
  subTitle         String?
  order            Int             @default(0)
  categoryId       String
  discountPrice    String?
  regularPrice     String?
  basePrice        Int             @default(0)
  estimatedMinutes Int             @default(60)
  notes            String?
  details          ServiceDetail[]
  category         ServiceCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  options          ServiceOption[]
  servicePages     ServicePage[]
}

model ServiceDetail {
  id         String      @id @default(uuid())
  label      String?
  value      String
  order      Int         @default(0)
  itemId     String
  labelAlign String      @default("left")
  labelColor String      @default("default")
  labelSize  String      @default("sm")
  valueAlign String      @default("right")
  valueColor String      @default("default")
  valueSize  String      @default("base")
  item       ServiceItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
}

model ServiceOption {
  id                String      @id @default(uuid())
  title             String
  price             Int         @default(0)
  additionalMinutes Int         @default(0)
  itemId            String
  regularPrice      String?
  subTitle          String?
  discountType      String      @default("NONE")
  discountValue     Int         @default(0)
  linkedItemId      String?
  item              ServiceItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
}

model ServiceArea {
  id        String   @id @default(uuid())
  title     String
  regions   String
  note      String?
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model LandingPage {
  id                String            @id @default(uuid())
  slug              String            @unique
  title             String
  status            String            @default("DRAFT")
  heroImage         String?
  catchphrase       String?
  subCopy           String?
  content           String?
  ctaText           String?           @default("無料お見積りはこちら")
  ctaLink           String?           @default("/contact")
  blocks            Json?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  showOnHome        Boolean           @default(false)
  category          String            @default("CAMPAIGN")
  linkTitle         String?
  metaDescription   String?
  metaKeywords      String?
  noIndex           Boolean           @default(false)
  canonicalUrl      String?
  showBottomCta     Boolean           @default(true)
  bookingData       Json?
  bookingMenus      BookingMenu[]     @relation("LpBookingMenus")
  bookingCategories BookingCategory[]

  // ===== リッチLPテンプレート用（templateStyle="RICH"の場合のみ使用） =====
  templateStyle     String            @default("SIMPLE") // "SIMPLE" | "RICH"
  heroEyebrow       String?
  heroSubtitle      String?
  heroPriceLead     String?
  serviceLabel      String?
  pains             Json?
  menuIntro         String?
  campaignBadge     String?
  menuItems         Json?
  menuOptions       Json?
  baseWork          Json?
  setNote           String?
  recommended       Json?
  reasons           Json?
  faqItems          Json?
  voices            Json?
  steps             Json?
  beforeAfters      BeforeAfter[]
  // 追加メニュー(menuOptions)のうち、予約マスターと連動させたいもの。
  // 価格・名称は保存せず常にマスターの最新値から解決する（menuOptionsは手入力の項目用に残す）。
  // 予約マスター側でオプションとして作られている場合はBookingOption、
  // 小分類自体を「追加メニュー」として使っている場合はBookingSubMenuを選べるようにする。
  menuOptionRefs    BookingOption[]
  menuSubMenuRefs   BookingSubMenu[]
  // 料金表(menuItems)の項目を予約マスターの中分類と連動させたいもの。
  // 名称・価格・作業内容・注意事項は保存せず常にマスターの最新値から解決する。
  menuItemRefs      BookingMenu[]     @relation("LpMenuItemRefs")
}

model CtaBlock {
  id            String   @id @default(uuid())
  name          String
  bgType        String   @default("solid")
  bgColor1      String   @default("#eff6ff")
  bgColor2      String?
  borderColor   String   @default("#bfdbfe")
  borderRadius  Int      @default(16)
  paddingY      Int      @default(32)
  paddingX      Int      @default(32)
  headingText   String?
  headingColor  String   @default("#1e293b")
  headingSize   Int      @default(20)
  headingWeight String   @default("700")
  desc1Text     String?
  desc1Color    String   @default("#475569")
  desc1Size     Int      @default(14)
  desc1Weight   String   @default("400")
  linkText      String?
  linkUrl       String?
  linkColor     String   @default("#2563eb")
  linkSize      Int      @default(14)
  linkWeight    String   @default("700")
  desc2Text     String?
  desc2Color    String   @default("#475569")
  desc2Size     Int      @default(14)
  desc2Weight   String   @default("400")
  btn1Text      String?
  btn1Url       String?
  btn1BgColor   String   @default("#2563eb")
  btn1TextColor String   @default("#ffffff")
  btn1Size      Int      @default(16)
  btn1Weight    String   @default("700")
  btn1Radius    Int      @default(9999)
  btn1PaddingY  Int      @default(14)
  btn1PaddingX  Int      @default(40)
  desc3Text     String?
  desc3Color    String   @default("#475569")
  desc3Size     Int      @default(14)
  desc3Weight   String   @default("400")
  btn2Text      String?
  btn2Url       String?
  btn2BgColor   String   @default("#e2e8f0")
  btn2TextColor String   @default("#334155")
  btn2Size      Int      @default(14)
  btn2Weight    String   @default("700")
  desc4Text     String?
  desc4Color    String   @default("#475569")
  desc4Size     Int      @default(14)
  desc4Weight   String   @default("400")
  telText       String?
  telNumber     String?
  telColor      String   @default("#2563eb")
  telSize       Int      @default(20)
  telWeight     String   @default("700")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model BlogCategory {
  id        String     @id @default(uuid())
  name      String     @unique
  slug      String     @unique
  order     Int        @default(0)
  posts     BlogPost[]
  createdAt DateTime   @default(now())
}

model BlogPost {
  id              String        @id @default(uuid())
  slug            String        @unique
  title           String
  content         String
  instaContent    String?
  xContent        String?
  googleContent   String?
  thumbnail       String?
  status          String        @default("DRAFT")
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  metaDescription String?
  metaKeywords    String?
  noIndex         Boolean       @default(false)
  categoryId      String?
  category        BlogCategory? @relation(fields: [categoryId], references: [id])
}

model BlogSettings {
  id            String   @id @default("main")
  fixedKeywords String   @default("")
  defaultIntro  String   @default("")
  defaultOutro  String   @default("")
  updatedAt     DateTime @updatedAt
}

model IndexNowLog {
  id        String   @id @default(uuid())
  url       String   @unique
  status    Int
  response  String?
  createdAt DateTime @default(now())
}

model SiteSettings {
  id                String   @id @default("main")
  robotsTxt         String   @default("User-agent: *\nAllow: /\nDisallow: /admin/")
  reviewIpBlock     Boolean  @default(true)
  calendarStartHour Int      @default(5)
  calendarEndHour   Int      @default(22)
  updatedAt         DateTime @updatedAt
}

model Booking {
  id           String   @id @default(uuid())
  category     String
  customerName String
  email        String
  phone        String
  startTime    DateTime
  endTime      DateTime
  status       String   @default("PENDING")
  createdAt    DateTime @default(now())
  items        String
  totalMinutes Int
  totalPrice   Int
  address      String?
  notes        String?
}

model CalendarOverride {
  id        String   @id @default(uuid())
  slotTime  DateTime @unique
  status    String
  note      String?
  updatedAt DateTime @updatedAt
}

model ServicePage {
  id                String            @id @default(uuid())
  slug              String            @unique
  title             String
  linkTitle         String?
  heroImage         String?
  catchphrase       String?
  content           String?
  status            String            @default("DRAFT")
  metaKeywords      String?
  metaDescription   String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  serviceItemId     String?
  serviceItem       ServiceItem?      @relation(fields: [serviceItemId], references: [id], onDelete: SetNull)
  bookingData       Json?
  noIndex           Boolean           @default(false)
  canonicalUrl      String?
  redirectUrl       String?
  showOnHome        Boolean           @default(false)
  cardIcon          String?
  faqs              ServiceFaq[]
  testimonials      Testimonial[]
  bookingMenus      BookingMenu[]
  bookingCategories BookingCategory[]
  displayMenuIds    String[]          @default([])
  beforeAfters      BeforeAfter[]
}

model ServiceFaq {
  id            String      @id @default(uuid())
  servicePageId String
  question      String
  answer        String
  order         Int         @default(0)
  createdAt     DateTime    @default(now())
  servicePage   ServicePage @relation(fields: [servicePageId], references: [id], onDelete: Cascade)
}

model Testimonial {
  id            String       @id @default(uuid())
  servicePageId String?
  authorLabel   String
  rating        Int?
  body          String
  order         Int          @default(0)
  isActive      Boolean      @default(true)
  createdAt     DateTime     @default(now())
  servicePage   ServicePage? @relation(fields: [servicePageId], references: [id], onDelete: SetNull)
}

model BookingCategory {
  id               String        @id @default(uuid())
  title            String
  order            Int           @default(0)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  setDiscountRules Json?
  menus            BookingMenu[]
  servicePages     ServicePage[]
  landingPages     LandingPage[]
}

model BookingMenu {
  id               String           @id @default(uuid())
  title            String
  basePrice        Int              @default(0)
  durationMin      Int              @default(0)
  durationMax      Int?
  order            Int              @default(0)
  categoryId       String
  workContent      String?
  cautionNote      String?
  recommendPoint   String?
  onSiteEstimate   String           @default("NONE")
  priceNote        String?
  setDiscountRules Json?
  discountPercent  Float?
  discountRounding String           @default("NONE")
  webSpecialPrice  Int?
  category         BookingCategory  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  subMenus         BookingSubMenu[]
  options          BookingOption[]
  servicePages     ServicePage[]
  landingPages     LandingPage[]     @relation("LpBookingMenus")
  landingPagesAsMenuItem LandingPage[] @relation("LpMenuItemRefs")
}

model BookingSubMenu {
  id               String          @id @default(uuid())
  title            String
  price            Int             @default(0)
  durationMin      Int             @default(0)
  durationMax      Int?
  order            Int             @default(0)
  menuId           String
  workContent      String?
  cautionNote      String?
  recommendPoint   String?
  onSiteEstimate   String          @default("NONE")
  discountPercent  Float?
  discountRounding String          @default("NONE")
  webSpecialPrice  Int?
  options          BookingOption[]
  menu             BookingMenu     @relation(fields: [menuId], references: [id], onDelete: Cascade)
  landingPages     LandingPage[]
}

model BookingOption {
  id               String          @id @default(uuid())
  title            String
  price            Int             @default(0)
  durationMin      Int             @default(0)
  durationMax      Int?
  order            Int             @default(0)
  workContent      String?
  cautionNote      String?
  recommendPoint   String?
  onSiteEstimate   String          @default("NONE")
  maxQty           Int?
  discountPercent  Float?
  discountRounding String          @default("NONE")
  qtyDiscountRules Json?
  subMenuId        String?
  subMenu          BookingSubMenu? @relation(fields: [subMenuId], references: [id], onDelete: Cascade)
  menuId           String?
  menu             BookingMenu?    @relation(fields: [menuId], references: [id], onDelete: Cascade)
  landingPages     LandingPage[]
}

model TopPriceItem {
  id        String   @id @default(uuid())
  title     String
  price     String
  unit      String   @default("円〜(税込)")
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ReviewLog {
  id        String   @id @default(cuid())
  ip        String
  rating    Int
  createdAt DateTime @default(now())

  @@index([ip, createdAt])
}
